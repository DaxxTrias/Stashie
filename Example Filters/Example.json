{
  "ParentMenu": [
    {
      "MenuName": "Waystones",
      "Filters": [
        {
          "FilterName": "All Waystones",
          "RawQuery": "MapInfo.IsMap",
          "Shifting": false,
          "Affinity": true
        },
        {
          "FilterName": "High Tier Waystones",
          "RawQuery": "MapInfo.IsMap && MapInfo.Tier >= 10",
          "Shifting": false,
          "Affinity": true
        },
        {
          "FilterName": "Corrupted Waystones",
          "RawQuery": "MapInfo.IsMap && IsCorrupted",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Currency",
      "Filters": [
        {
          "FilterName": "Currency Items",
          "RawQuery": "ClassName.Contains(\"Currency\") || Path.Contains(\"Currency\")",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Fragments",
      "Filters": [
        {
          "FilterName": "Fragments",
          "RawQuery": "ClassName.Contains(\"Fragment\") || BaseName.Contains(\"Fragment\") || Path.Contains(\"Fragment\")",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Skill Gems",
      "Filters": [
        {
          "FilterName": "Skill Gems",
          "RawQuery": "GemInfo.IsGem",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Flasks",
      "Filters": [
        {
          "FilterName": "Flasks",
          "RawQuery": "ClassName.Contains(\"Flask\") && Rarity != ItemRarity.Unique",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Jewels",
      "Filters": [
        {
          "FilterName": "Jewels",
          "RawQuery": "ClassName.Contains(\"Jewel\") && Rarity != ItemRarity.Unique",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Uniques",
      "Filters": [
        {
          "FilterName": "Unique Equipment",
          "RawQuery": "Rarity == ItemRarity.Unique && !MapInfo.IsMap",
          "Shifting": false,
          "Affinity": true
        }
      ]
    },
    {
      "MenuName": "Leftovers",
      "Filters": [
        {
          "FilterName": "Rare Non-Waystones",
          "RawQuery": "!MapInfo.IsMap && Rarity == ItemRarity.Rare",
          "Shifting": true,
          "Affinity": false
        },
        {
          "FilterName": "Magic Non-Waystones",
          "RawQuery": "!MapInfo.IsMap && Rarity == ItemRarity.Magic",
          "Shifting": true,
          "Affinity": false
        }
      ]
    }
  ]
}